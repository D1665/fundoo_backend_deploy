# ================== .env.example ==================
# Copy this file to .env and fill in your real values.
# ==================================================

# ---------- SERVER ----------
SERVER_PORT=8086

# ---------- POSTGRESQL ----------
DB_URL=jdbc:postgresql://localhost:5432/fundoodb
DB_USERNAME=postgres
DB_PASSWORD=your_secure_password

# ---------- REDIS ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---------- RABBITMQ ----------
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ---------- MAIL (for OTP emails) ----------
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_gmail_username@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# ---------- JWT ----------
# Generate a secure 256-bit or 512-bit key (64 character hex string)
JWT_SECRET=your_jwt_secret_key_at_least_64_characters_long
JWT_EXPIRATION=86400000
